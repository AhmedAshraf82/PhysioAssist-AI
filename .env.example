# ==============================
# PhysioAssist Backend (.env)
# ==============================

# API keys
OPENAI_API_KEY=sk-your-openai-key
GROK_API_KEY=
GEMINI_API_KEY=

# MongoDB
MONGODB_CONNECTION_STRING=mongodb://admin:physioassist_pass@localhost:27018/
MONGODB_DATABASE_NAME=v33
MONGODB_COLLECTION_NAME=injuries

# Search service selector
SEARCH_SERVICE_TYPE=elasticsearch

# Local Docker Elasticsearch (default local dev)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_SCHEME=http

# Elastic Cloud (Render/production). If set, these are used by search client.
# ELASTIC_SEARCH_ENDPOINT=https://xxxx.region.cloud.es.io:443
# ELASTIC_SEARCH_KEY=base64_api_key

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSIONS=1536

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.onrender\.com
