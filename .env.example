# Application Settings
APP_NAME=PhysioAssist-AI
VERSION=0.1.0
DEBUG=True
API_PREFIX=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
# OPENAI_API_KEY=your_key_here

# WhatsApp Cloud API
# Set these in Render for backend service
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v22.0
# Optional: enables webhook signature verification
WHATSAPP_WEBHOOK_SECRET=
# Optional: template fallback when user is outside 24h customer care window
WHATSAPP_ENABLE_TEMPLATE_FALLBACK=true
WHATSAPP_FALLBACK_TEMPLATE_NAME=
WHATSAPP_FALLBACK_TEMPLATE_LANG=en_US

# Twilio WhatsApp (Sandbox testing)
# You can test without these if returning TwiML only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
